@using Getright.Dashboard.Components.Pages
@inject RunStore Store

<section class="panel generation-progress" aria-label="Test case generation progress">
    <div class="panel-heading"><div><h2>Test case generation progress</h2><p>Latest automation attempt per approved case in the current application and suite filters. Refreshes every 3 seconds.</p></div><span class="counter">@rows.Count</span></div>
    <div class="generation-progress-body">
        @if (rows.Count == 0)
        { <p class="muted">No test implementations yet in this view. Approve a draft case to generate and validate its automation.</p> }
        else
        {
            <div class="generation-counts">
                <span><strong>@Queued</strong> queued</span><span><strong>@Active</strong> in progress</span><span><strong>@Verified</strong> verified</span><span><strong>@Attention</strong> need attention</span><span><strong>@Cancelled</strong> cancelled</span>
            </div>
            <label class="generation-completion" for="case-generation-completion">@Finished of @rows.Count implementations finished · @rows.Count(r => r.Ready) ready to run</label>
            <progress id="case-generation-completion" value="@Finished" max="@rows.Count" aria-label="Finished test case implementations"></progress>
            <p class="muted">Finished includes unsuccessful attempts. A case becomes runnable only after both validation runs pass; human acceptance stays pending.</p>
            @if (Queued > 0 && Active == 0)
            { <p class="notice generation-worker-note">Waiting for the local worker to pick up @Queued @(Queued == 1 ? "case" : "cases"). Start or restart it with <code>./scripts/start-worker.ps1</code>. A visible test browser left open for review can also hold up the queue.</p> }
            <ul class="generation-case-list">
                @foreach (var row in rows)
                {
                    var job = row.Job;
                    <li class="generation-case" @key="job.Id">
                        <div class="generation-case-heading"><a href="/case-implementations/@job.Id">@job.TestSnapshot.Title</a><span class="badge @job.Status">@(row.Ready ? "Ready" : CaseImplementationStates.Blocked(job) ? "Prerequisites missing" : Stage(job.Status))</span></div>
                        <p class="generation-case-message preserve-lines">@(job.Error ?? row.Latest?.Message ?? "Waiting for the local worker.")</p>
                        @if (job.SharedBuild is { } shared) { <p class="muted">Shared application build @shared.BuildVersion · <a href="/case-implementations/@shared.OwnerJobId">build details</a> · separate validation host for this case.</p> }
                        @if (job.Status == "verified" && !row.Ready) { <p class="muted">Automation is disabled or needs reverification for the configured build.</p> }
                        @if (job.CancelRequested && CaseImplementationStates.Active(job.Status)) { <p class="muted">Cancellation requested.</p> }
                        @if (CaseImplementationStates.Retryable(job.Status)) { <RetryCaseGeneration Job="job" Queued="OnRetryQueued" /> }
                        @if (row.Validations.Count > 0)
                        {
                            <div class="generation-validations"><span>@row.Validations.Count(r => r.Status == "passed")/2 validations passed</span>
                                @foreach (var run in row.Validations) { <a href="/runs/@run.Id">Validation @(row.Validations.IndexOf(run) + 1): @Home.Label(run.Status)</a> }
                            </div>
                        }
                        <small class="muted">Last update <time datetime="@((row.Latest?.CreatedAt ?? job.UpdatedAt).ToString("O"))">@((row.Latest?.CreatedAt ?? job.UpdatedAt).ToLocalTime().ToString("g"))</time></small>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<UatTest> Tests { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }
    private async Task OnRetryQueued(CaseImplementationJob _) { await Changed.InvokeAsync(); OnParametersSet(); }
    private record ProgressRow(CaseImplementationJob Job, JobEvent? Latest, List<UatRun> Validations, bool Ready);
    private List<ProgressRow> rows = [];
    private int Queued => rows.Count(r => r.Job.Status == "queued");
    private int Active => rows.Count(r => CaseImplementationStates.Active(r.Job.Status));
    private int Verified => rows.Count(r => r.Job.Status == "verified");
    private int Attention => rows.Count(r => r.Job.Status is "failed" or "interrupted" or "blocked");
    private int Cancelled => rows.Count(r => r.Job.Status == "cancelled");
    private int Finished => Verified + Attention + Cancelled;
    protected override void OnParametersSet()
    {
        rows = Store.LatestCaseJobs(Tests.Select(t => t.Id))
            .OrderBy(j => CaseImplementationStates.Active(j.Status) ? 0 : j.Status == "queued" ? 1 : j.Status is "failed" or "interrupted" or "blocked" ? 2 : 3)
            .ThenByDescending(j => j.UpdatedAt)
            .Select(j => new ProgressRow(j, Store.LatestCaseEvent(j.Id), (j.ValidationRunIds ?? []).Select(Store.Get).ToList(), Ready(j))).ToList();
    }
    private bool Ready(CaseImplementationJob job)
    {
        var test = Tests.First(t => t.Id == job.TestId);
        if (job.Status != "verified" || test.Readiness != "ready" || test.Implementation?.JobId != job.Id) return false;
        if (test.ApplicationId == "getright") return true;
        var profile = Store.Profile(test.ApplicationId);
        return profile is not null && !profile.SourceWasDirty && profile.SourceCommit == test.Implementation.ApplicationSourceCommit;
    }
    private static string Stage(string status) => status switch { "planning" => "Checking prerequisites and generating automation", "implementing" => "Generating automation", _ => Home.Label(status) };
}
