@page "/applications"
@inject RunStore Store
@inject ApplicationSetup Setup

<PageTitle>Application setup · Getright</PageTitle>
<div class="topbar"><a href="/">Test control room</a><span>Application setup</span></div>
<header class="page-header"><div><p class="eyebrow">LOCAL APPLICATIONS</p><h1>Application setup</h1><p class="muted">Connect a local test instance before running a real application workflow.</p></div></header>
<section class="panel setup-panel">
    <div class="panel-heading"><div><h2>@(applicationId == "writerapp" ? "WriterApp" : "Virtual Company")</h2><p>Connect the isolated instance using its launch receipt.</p></div></div>
    <div class="setup-form">
        <label for="application">Application</label><select id="application" @bind="applicationId" @bind:after="Load" disabled="@(busy || !RendererInfo.IsInteractive)"><option value="writerapp">WriterApp</option><option value="virtual-company">Virtual Company</option></select>
        <p>Use an isolated development instance with automatic test sign-in. Getright checks the running build and account before creating data.</p>
        <label for="base-url">Local application URL</label><input id="base-url" @bind="baseUrl" disabled="@(busy || !RendererInfo.IsInteractive)" placeholder="http://localhost:5387" />
        <label for="build-version">Expected build version</label><input id="build-version" @bind="buildVersion" disabled="@(busy || !RendererInfo.IsInteractive)" placeholder="Version reported by the intended local build" />
        <small>The instance must report this exact version. Use a distinct version for each build you compare.</small>
        <label for="test-account">Dedicated UAT account ID</label><input id="test-account" @bind="userId" disabled="@(busy || !RendererInfo.IsInteractive)" placeholder="getright-uat" />
        @if (applicationId == "virtual-company")
        { <label for="reference-company">Reference company ID</label><input id="reference-company" @bind="companyId" disabled="@(busy || !RendererInfo.IsInteractive)" /><p class="muted">The owner role and this reference company are checked before each run.</p> }
        <label for="source-commit">Clean source commit from launch receipt</label><input id="source-commit" @bind="sourceCommit" disabled="@(busy || !RendererInfo.IsInteractive)" />
        <label class="checkbox-label"><input type="checkbox" @bind="sourceWasDirty" disabled="@(busy || !RendererInfo.IsInteractive)" /> Source had uncommitted changes (implementation jobs stay disabled).</label>
        <label class="checkbox-label"><input type="checkbox" @bind="isolated" disabled="@(busy || !RendererInfo.IsInteractive)" /> This instance uses isolated UAT data and a dedicated test account.</label>
        <div class="review-actions"><button disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="Save">Save setup</button><button class="secondary" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="Check">Check connection</button><a href="/">Return to tests</a></div>
        @if (message is not null) { <p role="status" class="@(ready ? "success-text" : "muted")">@message</p> }
        @if (error is not null) { <p role="alert" class="error-text">@error</p> }
    </div>
</section>
<div class="notice">Synopsis, edit/reopen, sharing and save-failure recovery are the remaining milestone 1 adapters. Virtual Company currently supports test-company creation and draft permissions.</div>

@code {
    private string applicationId = "writerapp", companyId = "", sourceCommit = "";
    private bool sourceWasDirty;
    private string baseUrl = "http://localhost:5387", buildVersion = "", userId = "dev-oid";
    private bool isolated, busy, ready;
    private string? message, error;
    protected override void OnInitialized() => Load();
    private void Load()
    {
        var profile = Store.Profile(applicationId);
        baseUrl = profile?.BaseUrl ?? "http://localhost:5387"; buildVersion = profile?.ExpectedBuildVersion ?? ""; userId = profile?.ExpectedUserId ?? (applicationId == "writerapp" ? "dev-oid" : ""); isolated = profile?.IsolatedDataConfirmed ?? false;
        companyId = profile?.ExpectedCompanyId ?? ""; sourceCommit = profile?.SourceCommit ?? ""; sourceWasDirty = profile?.SourceWasDirty ?? false; message = error = null; ready = false;
    }
    private void Save()
    {
        try
        {
            var saved = Store.SaveProfile(new ApplicationProfile(applicationId, baseUrl, buildVersion, userId, isolated, string.IsNullOrWhiteSpace(sourceCommit) ? null : sourceCommit.Trim(), sourceWasDirty, applicationId == "virtual-company" ? companyId.Trim() : null, applicationId == "virtual-company" ? "owner" : null));
            baseUrl = saved.BaseUrl; buildVersion = saved.ExpectedBuildVersion; userId = saved.ExpectedUserId;
            error = null; ready = false; message = "Setup saved. Check the connection before running a test.";
        }
        catch (ArgumentException exception) { error = exception.Message; message = null; }
    }
    private async Task Check()
    {
        Save(); if (error is not null) return;
        busy = true;
        try { var result = await Setup.Check(applicationId); ready = result.Ready; message = result.Message; }
        finally { busy = false; }
    }
}
