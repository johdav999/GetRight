@page "/"

@inject UatCatalogue Catalogue
@inject RunStore Store
@inject ApplicationSetup Setup
@implements IAsyncDisposable

<PageTitle>Getright · Test control room</PageTitle>

<div class="topbar"><span>Workspace <span class="muted">/</span> Test control room</span><span class="local-label">LOCAL UAT</span></div>
<header class="page-header"><div><p class="eyebrow">BUILD CONFIDENCE, ONE WORKFLOW AT A TIME</p><h1>Test control room</h1><p class="muted">Run a workflow. Review the evidence. Make the next version better.</p></div><button class="secondary" @onclick="Refresh">Refresh results</button></header>
<div class="stats">
    <div><span>Applications</span><strong>@Catalogue.Value.Applications.Count</strong></div>
    <div><span>Configured tests</span><strong>@tests.Count(CanRun) <small>/ @tests.Count cases</small></strong></div>
    <div><span>Recent automated passes</span><strong>@runs.Count(r => r.Status == "passed")</strong></div>
    <div><span>Recent runs awaiting review</span><strong>@runs.Count(r => r.CompletedAt is not null && r.Acceptance == "pending")</strong></div>
</div>
<section class="panel suite-toolbar" aria-label="Test suite selection">
    <div><label for="suite-filter">Test suite</label><select id="suite-filter" @bind="suiteId" @bind:after="SelectSuite" disabled="@(!RendererInfo.IsInteractive)"><option value="">All suites</option>@foreach (var suite in suites) { <option value="@suite.Id">@suite.Name (@suite.TestIds.Count @(suite.TestIds.Count == 1 ? "case" : "cases"))</option> }</select></div>
    <div><a class="button-link secondary" href="/suites">Manage suites &amp; generate cases</a><p class="muted">@(suites.FirstOrDefault(s => s.Id == suiteId)?.Description ?? "Group test cases into suites, or describe a feature to generate draft cases.")</p></div>
</section>
<CaseGenerationProgress Tests="@VisibleTests.ToList()" />
<div class="workspace-grid">
<section class="panel catalogue">
    <div class="panel-heading"><div><h2>Your test cases</h2><p>Automation and acceptance are tracked separately.</p></div><span class="counter">@VisibleTests.Count()</span></div>
    <div class="filters" role="group" aria-label="Filter by application">
        <button class="@(filter == "all" ? "filter selected" : "filter")" disabled="@(!RendererInfo.IsInteractive)" @onclick='() => SetFilter("all")'>All applications</button>
        @foreach (var application in Catalogue.Value.Applications)
        { <button class="@(filter == application.Id ? "filter selected" : "filter")" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => SetFilter(application.Id)">@application.Name</button> }
    </div>
    <BulkCaseApproval Tests="@VisibleTests.ToList()" Changed="Refresh" />
    @foreach (var test in VisibleTests)
    {
        var latest = runs.FirstOrDefault(r => r.TestId == test.Id);
        <article class="test-card @(selectedTest?.Id == test.Id ? "active" : "")">
            <div class="test-card-top"><span class="app-label">@AppName(test.ApplicationId)</span><span class="badge @test.Readiness">@Label(test.Readiness == "setup-required" && CanRun(test) ? "configured" : test.Readiness)</span></div>
            <button class="test-title" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => Select(test)">@test.Title</button>
            <p>@test.Purpose</p>
            <div class="test-card-bottom"><div><span class="mini-label">AUTOMATED</span><span class="badge @(latest?.Status ?? "not-run")">@Label(latest?.Status ?? "not-run")</span></div><div><span class="mini-label">ACCEPTANCE</span><span class="badge @(latest?.Acceptance ?? "pending")">@Label(latest?.Acceptance ?? "pending")</span></div></div>
            <div class="test-card-actions">
                @if (test.Readiness == "draft" || test.Implementation is not null) { <button class="secondary" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => Select(test)">@(test.Implementation is null ? "Review draft" : "Review automation")</button> }
                @if (CanRun(test)) { <TestPageButton TestId="@test.Id" Title="@test.Title" /> }
                else { <button class="secondary open-test-page" disabled title="Configure a supported isolated test instance first">Open test page</button> }
                <button class="run-button" disabled="@(!CanRun(test) || queueing || !RendererInfo.IsInteractive)" @onclick="() => Queue(test)">Run UAT test <span aria-hidden="true">↗</span></button>
            </div>
        </article>
    }
</section>
<div class="detail-column">
@if (selectedTest is { } implementTest && (implementTest.Readiness == "draft" || implementTest.Implementation is not null)) { <CaseImplementationPanel @key="(typeof(CaseImplementationPanel), implementTest.Id)" Test="implementTest" Changed="Refresh" /> }
@if (selectedTest is { } reviewTest) { <QuickRunReview @key="reviewTest.Id" LatestRun="@runs.FirstOrDefault(r => r.TestId == reviewTest.Id)" Changed="Refresh" /> }
<section class="panel detail" aria-label="Test details">
    @if (selectedTest is { } current)
    {
        <div class="panel-heading"><div><span class="eyebrow">WORKFLOW DETAIL</span><h2>@current.Title</h2></div></div>
        @if (current.Readiness == "draft")
        { <div class="notice">This test is a draft. Configure isolated data, login, build identification and an executable adapter before running it.</div> }
        @if (current.Preconditions is { } preconditions) { <div class="notice"><strong>Preconditions</strong><p class="preserve-lines">@preconditions</p></div> }
        @if (current.Readiness == "setup-required")
        { <div class="notice">This adapter tests an actual local application instance. <a href="/applications">Configure its build, account and isolated data</a> before running. The connection is checked again for each run.</div> }
        <ol class="steps">@foreach (var step in current.Steps) { <li><strong>@step.Title</strong><p>@step.Expected</p></li> }</ol>
        <div class="review-question"><span class="mini-label">HUMAN REVIEW</span><p>@current.ReviewQuestion</p></div>
        <p class="detail-note">Open test page opens the configured running build in the left panel for manual review. Use Undock to open its entry page in a standalone tab. Manual review creates no run or automated result.</p>
        <h3>Run history</h3><a href="/history">Browse all runs and compare evidence</a>
        @if (!runs.Any(r => r.TestId == current.Id))
        { <div class="empty-state"><span aria-hidden="true">◷</span><strong>A fresh start</strong><p>Your first run will appear here with its screenshots and results.</p></div> }
        @foreach (var run in runs.Where(r => r.TestId == current.Id).Take(12))
        { <a class="history-row" href="/runs/@run.Id"><div><strong>@run.CreatedAt.ToLocalTime().ToString("g")</strong><small>@run.Id[..8]</small></div><span class="badge @run.Status">@Label(run.Status)</span><span class="badge @run.Acceptance">@Label(run.Acceptance)</span></a> }
    }
    else { <div class="empty-state"><strong>This suite has no cases yet.</strong><p><a href="/suites">Add existing cases or generate cases from a feature.</a></p></div> }
</section>
</div>
</div>
<div class="setup-note"><strong>Start the local worker to execute queued tests and jobs.</strong><code>npm run start --prefix worker</code><span>Open feedback to prepare an editable Codex job. Implementation starts only after you request it.</span></div>
@if (message is not null) { <div class="toast" role="status">@message <button @onclick="() => message = null" aria-label="Dismiss notification">×</button></div> }

@code {
    private List<UatRun> runs = [];
    private List<UatTest> tests = [];
    private List<TestSuite> suites = [];
    private UatTest? selectedTest;
    private string filter = "all";
    private string suiteId = "";
    private IEnumerable<UatTest> VisibleTests => tests.Where(t => (filter == "all" || t.ApplicationId == filter) && (suiteId == "" || suites.FirstOrDefault(s => s.Id == suiteId)?.TestIds.Contains(t.Id) == true));
    private string? message;
    private bool writerConfigured, companyConfigured, queueing;
    private readonly CancellationTokenSource stop = new();
    private Task? polling;
    protected override void OnInitialized()
    {
        Refresh(); polling = Poll();
    }
    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try { while (await timer.WaitForNextTickAsync(stop.Token)) await InvokeAsync(() => { Refresh(); StateHasChanged(); }); }
        catch (OperationCanceledException) { }
    }
    private void Refresh() { tests = Store.Tests(); suites = Store.Suites(); runs = tests.SelectMany(t => Store.History(size: 12, test: t.Id).Items).OrderByDescending(r => r.CreatedAt).ToList(); writerConfigured = Store.Profile("writerapp") is not null; companyConfigured = Store.Profile("virtual-company") is not null; EnsureSelection(); }
    private void EnsureSelection() { selectedTest = VisibleTests.FirstOrDefault(t => t.Id == selectedTest?.Id) ?? VisibleTests.FirstOrDefault(); }
    private void SetFilter(string application) { filter = application; suiteId = ""; EnsureSelection(); }
    private void SelectSuite() { if (suites.FirstOrDefault(s => s.Id == suiteId) is { } suite) filter = suite.ApplicationId; EnsureSelection(); }
    private bool CanRun(UatTest test)
    {
        if (test.Adapter == WorkflowContract.Adapter)
        {
            if (test.Implementation is null || test.Readiness != "ready") return false;
            if (test.ApplicationId == "getright") return true;
            var profile = Store.Profile(test.ApplicationId);
            return profile is not null && !profile.SourceWasDirty && profile.SourceCommit == test.Implementation.ApplicationSourceCommit;
        }
        return test.Readiness == "ready" || (test.Adapter == "writerapp-create-save" && writerConfigured) || (test.Adapter == "virtual-company-test-setup" && companyConfigured);
    }
    private void Select(UatTest test) => selectedTest = test;
    private string AppName(string id) => Catalogue.Value.Applications.First(a => a.Id == id).Name;
    public static string Label(string value) => value switch { "not-run" => "Not run", "setup-required" => "Setup required", "awaiting-review" => "Awaiting review", "improvements-requested" => "Improvements requested", _ => char.ToUpperInvariant(value[0]) + value[1..] };
    private async Task Queue(UatTest test)
    {
        queueing = true;
        try { var run = await Setup.Queue(test.Id); selectedTest = test; message = $"Run {run.Id[..8]} queued. The local worker will pick it up."; Refresh(); }
        catch (ArgumentException error) { message = error.Message; }
        finally { queueing = false; }
    }
    public async ValueTask DisposeAsync() { await stop.CancelAsync(); if (polling is not null) await polling; stop.Dispose(); }
}
